# =============================================================================
# WSL / UBUNTU - .zshrc
# =============================================================================

# 1. PATH & ENVIRONMENT
# -----------------------------------------------------------------------------
export PATH="$HOME/.local/bin:$PATH" # [cite: 5]
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)" # [cite: 12]

# Boot up x-cmd
[ ! -f "$HOME/.x-cmd.root/X" ] || . "$HOME/.x-cmd.root/X" # [cite: 6, 7]

# 2. AESTHETICS & PROMPT
# -----------------------------------------------------------------------------
PROMPT='%F{cyan}[%1d] > %f' # [cite: 13]

# Enable colorized output for ls (Ubuntu/GNU format)
alias ls='ls --color=auto' # [cite: 8, 13]
alias grep='grep --color=auto' # [cite: 8]

# Set up GNU dircolors if available
if [ -x /usr/bin/dircolors ]; then
    eval "$(dircolors -b)" # [cite: 9, 13]
fi

# Enable auto-completion coloring
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}" # [cite: 10]

# 3. TMUX COCKPIT INITIALIZATION
# -----------------------------------------------------------------------------
# Auto-start tmux on shell login
if [[ -z "$TMUX" ]]; then
    tmux attach-session -t default || tmux new-session -s default # [cite: 5, 6]
fi

alias reload-tmux='tmux source-file ~/.tmux.conf && echo "Tmux reloaded."' # [cite: 8]
alias restart-tmux='tmux kill-server' # [cite: 8]

# 4. ALIASES & KEYBOARDS
# -----------------------------------------------------------------------------
alias search='ddgr --reg en-us --num 5' # [cite: 8]

# 'hidutil' is macOS-only; this alias is kept for cross-platform awareness
alias kbcheck='hidutil property --get "UserKeyMapping"' # [cite: 12]
alias fixkb='~/kb_toggle.sh' # [cite: 12]

# 5. AUTOMATED AUTHENTICATION (SSH Agent)
# -----------------------------------------------------------------------------
if [ -z "$SSH_AUTH_SOCK" ]; then
   eval "$(ssh-agent -s)" > /dev/null
   ssh-add ~/.ssh/id_ed25519 2>/dev/null
fi

# 6. DOTFILES AUTOMATION
# -----------------------------------------------------------------------------
function dot-sync() {
    local current_dir=$(pwd)
    cd ~/dotfiles
    git add -A  
    git commit -m "WSL sync: $(date +'%Y-%m-%d %H:%M')"
    git push origin main
    cd "$current_dir"
}

function dotpull() {
    local current_dir=$(pwd)
    cd ~/dotfiles
    echo "📥 Pulling latest changes (Rebasing local work)..."
    if git pull --rebase origin main; then
        source ~/.zshrc
        [ -n "$TMUX" ] && tmux display-message "Dotfiles Updated & Reloaded"
    else
        echo "❌ Conflict detected! Please resolve manually."
    fi
    cd "$current_dir"
}
alias dot-pull='dotpull'

# 7. PLUGINS
# -----------------------------------------------------------------------------
if [ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]; then
    source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh # [cite: 10]
fi
