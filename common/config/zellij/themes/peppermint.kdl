themes {
    peppermint {
        // --- Immersive Canvas (Uniform #000000 background) ---
        bg      "#000000"  // Pure Black — uniform backdrop across all panes
        black   "#353535"  // Subdued elements, inactive borders
        fg      "#c8c8c8"  // Default text color

        // --- Peppermint ANSI Palette ---
        red     "#e74669"  // Alerts, errors, deletions
        green   "#89d287"  // Success, additions, tasks
        yellow  "#dab853"  // Warnings, headers, incomplete tasks
        blue    "#449fd0"  // Primary accent, status indicators
        magenta "#da62dc"  // Metadata, tags, highlights
        cyan    "#14b8a6"  // Focus highlights, active borders (Teal)
        white   "#b4b4b4"  // Secondary text, subtle elements
        orange  "#e1e487"  // Bright yellow-orange for secondary alerts
    }
}
