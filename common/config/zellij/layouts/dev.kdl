layout {
    // 1. Top bar showing tab names
    pane size=1 borderless=true {
        plugin location="zellij:tab-bar"
    }

    // 2. Main workflow area
    pane split_direction="vertical" {
        pane size="70%" focus=true name="Editor"
        pane size="30%" split_direction="horizontal" {
            pane name="Server/Logs"
            pane name="Git/Task"
        }
    }

    // 3. Immersive Peppermint Status Bar
    pane size=1 borderless=true {
        plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
            // Layout Placement mapping
            format_left   "{mode}"
            format_center "#[fg={ENV:POLYTERM_COLOR_BRIGHT_BLACK},bg={ENV:POLYTERM_COLOR_BACKGROUND}] {command_alt}"
            format_right  "#[fg={ENV:POLYTERM_COLOR_YELLOW},bg={ENV:POLYTERM_COLOR_BACKGROUND}]Ctrl+g: toggle lock  #[fg={ENV:POLYTERM_COLOR_GREEN},bg={ENV:POLYTERM_COLOR_BACKGROUND}] {command_date} #[fg={ENV:POLYTERM_COLOR_BLUE},bg={ENV:POLYTERM_COLOR_BACKGROUND}] {command_time} "
            format_space  "#[bg={ENV:POLYTERM_COLOR_BACKGROUND}]"

            // Visually separated Date and Time blocks running custom formatting commands
            command_date_command "date +%Y-%m-%d"
            command_date_format  "{output}"
            command_date_interval "1"

            command_time_command "date +%H:%M:%S"
            command_time_format  "{output}"
            command_time_interval "1"

            // Static middle reference matching your Alt+ bindings
            command_alt_command  "echo 'alt+ n/i (focus)  alt+ +/- (resize)'"
            command_alt_format   "{output}"
            command_alt_interval "0"

            // --- Dynamic Interactive Shortcuts (Strictly Non-Bold / Peppermint Colorway) ---
            // These will change dynamically on the left when you switch modes
            mode_normal        "#[fg={ENV:POLYTERM_COLOR_CYAN},bg={ENV:POLYTERM_COLOR_BACKGROUND}] NORMAL #[fg={ENV:POLYTERM_COLOR_WHITE}]→ #[fg={ENV:POLYTERM_COLOR_CYAN}]Ctrl+g#[fg={ENV:POLYTERM_COLOR_FOREGROUND}] locked  #[fg={ENV:POLYTERM_COLOR_CYAN}]Ctrl+p#[fg={ENV:POLYTERM_COLOR_FOREGROUND}] pane  #[fg={ENV:POLYTERM_COLOR_CYAN}]Ctrl+t#[fg={ENV:POLYTERM_COLOR_FOREGROUND}] tab  #[fg={ENV:POLYTERM_COLOR_CYAN}]Ctrl+r#[fg={ENV:POLYTERM_COLOR_FOREGROUND}] resize"
            mode_locked        "#[fg={ENV:POLYTERM_COLOR_RED},bg={ENV:POLYTERM_COLOR_BACKGROUND}] LOCKED #[fg={ENV:POLYTERM_COLOR_WHITE}]→ Press #[fg={ENV:POLYTERM_COLOR_RED}]Ctrl+g#[fg={ENV:POLYTERM_COLOR_FOREGROUND}] to unlock"
            mode_pane          "#[fg={ENV:POLYTERM_COLOR_BLUE},bg={ENV:POLYTERM_COLOR_BACKGROUND}] PANE #[fg={ENV:POLYTERM_COLOR_WHITE}]→ #[fg={ENV:POLYTERM_COLOR_BLUE}]n#[fg={ENV:POLYTERM_COLOR_FOREGROUND}] new  #[fg={ENV:POLYTERM_COLOR_BLUE}]d#[fg={ENV:POLYTERM_COLOR_FOREGROUND}] down  #[fg={ENV:POLYTERM_COLOR_BLUE}]r#[fg={ENV:POLYTERM_COLOR_FOREGROUND}] right  #[fg={ENV:POLYTERM_COLOR_BLUE}]s#[fg={ENV:POLYTERM_COLOR_FOREGROUND}] stacked  #[fg={ENV:POLYTERM_COLOR_BLUE}]x#[fg={ENV:POLYTERM_COLOR_FOREGROUND}] close"
            mode_tab           "#[fg={ENV:POLYTERM_COLOR_PURPLE},bg={ENV:POLYTERM_COLOR_BACKGROUND}] TAB #[fg={ENV:POLYTERM_COLOR_WHITE}]→ #[fg={ENV:POLYTERM_COLOR_PURPLE}]n#[fg={ENV:POLYTERM_COLOR_FOREGROUND}] new  #[fg={ENV:POLYTERM_COLOR_PURPLE}]x#[fg={ENV:POLYTERM_COLOR_FOREGROUND}] close  #[fg={ENV:POLYTERM_COLOR_PURPLE}]h/l#[fg={ENV:POLYTERM_COLOR_FOREGROUND}] move  #[fg={ENV:POLYTERM_COLOR_PURPLE}]r#[fg={ENV:POLYTERM_COLOR_FOREGROUND}] rename"
            mode_resize        "#[fg={ENV:POLYTERM_COLOR_YELLOW},bg={ENV:POLYTERM_COLOR_BACKGROUND}] RESIZE #[fg={ENV:POLYTERM_COLOR_WHITE}]→ #[fg={ENV:POLYTERM_COLOR_YELLOW}]h/j/k/l#[fg={ENV:POLYTERM_COLOR_FOREGROUND}] scale  #[fg={ENV:POLYTERM_COLOR_YELLOW}]+/-#[fg={ENV:POLYTERM_COLOR_FOREGROUND}] size"
            mode_scroll        "#[fg={ENV:POLYTERM_COLOR_GREEN},bg={ENV:POLYTERM_COLOR_BACKGROUND}] SCROLL #[fg={ENV:POLYTERM_COLOR_WHITE}]→ #[fg={ENV:POLYTERM_COLOR_GREEN}]j/k#[fg={ENV:POLYTERM_COLOR_FOREGROUND}] up/down  #[fg={ENV:POLYTERM_COLOR_GREEN}]PageUp/Dn#[fg={ENV:POLYTERM_COLOR_FOREGROUND}] flip  #[fg={ENV:POLYTERM_COLOR_GREEN}]Ctrl+c#[fg={ENV:POLYTERM_COLOR_FOREGROUND}] exit"
            mode_move          "#[fg={ENV:POLYTERM_COLOR_CYAN},bg={ENV:POLYTERM_COLOR_BACKGROUND}] MOVE #[fg={ENV:POLYTERM_COLOR_WHITE}]→ #[fg={ENV:POLYTERM_COLOR_CYAN}]h/j/k/l#[fg={ENV:POLYTERM_COLOR_FOREGROUND}] shift layout position"
            mode_session       "#[fg={ENV:POLYTERM_COLOR_WHITE},bg={ENV:POLYTERM_COLOR_BACKGROUND}] SESSION #[fg={ENV:POLYTERM_COLOR_WHITE}]→ #[fg=white]d#[fg={ENV:POLYTERM_COLOR_FOREGROUND}] detach  #[fg=white]w#[fg={ENV:POLYTERM_COLOR_FOREGROUND}] session manager"
        }
    }
}
