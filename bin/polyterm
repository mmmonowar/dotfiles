#!/bin/bash

# Refuse to run setup as root — Homebrew does not support running as root
if [[ $EUID -eq 0 && "$1" == "setup" ]]; then
    echo -e "\033[0;31m'polyterm setup' must not be run as root.\033[0m"
    echo -e "\033[1;33mHomebrew drops privileges on installation and running it as root\033[0m"
    echo -e "\033[1;33mwould give all build scripts full access to your system.\033[0m"
    exit 1
fi

# ==========================================
# 🚀  POLYTERM CLI
# ==========================================
# Central management tool for the PolyTerm dotfiles environment.

# Determine the repository root dynamically
# Prioritize user's active repository (via DOTFILES_ROOT or ~/dotfiles) if valid
if [[ -n "$DOTFILES_ROOT" && -d "$DOTFILES_ROOT/common/palette" ]]; then
    REPO_PATH="$DOTFILES_ROOT"
elif [[ -d "$HOME/dotfiles/common/palette" ]]; then
    REPO_PATH="$HOME/dotfiles"
else
    # Fallback to resolving relative to the executable (handling symlinks recursively)
    SOURCE="$0"
    while [[ -h "$SOURCE" ]]; do
        DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
        SOURCE="$(readlink "$SOURCE")"
        [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
    done
    BIN_DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
    REPO_PATH="$( cd -P "$BIN_DIR/.." && pwd )"
fi

# Colors for output
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

function show_help() {
    echo -e "${BLUE}PolyTerm CLI${NC} - Dotfiles Management"
    echo ""
    echo -e "Usage: ${GREEN}polyterm${NC} [command] [options]"
    echo ""
    echo "Commands:"
    echo -e "  ${GREEN}palette${NC}  (Default) Launch the Tmux Command Palette"
    echo -e "  ${GREEN}setup${NC}    Run the bootstrap installer"
    echo -e "  ${GREEN}offboard${NC} Remove PolyTerm and restore system to defaults"
    echo -e "  ${GREEN}sync${NC}     Sync configurations to GitHub (dot-sync)"
    echo -e "  ${GREEN}pull${NC}     Pull latest updates from GitHub (dot-pull)"
    echo -e "  ${GREEN}reload${NC}   Reload configurations (interactive by default)"
    echo -e "  ${GREEN}help${NC}     Show this help message"
    echo ""
    echo "Reload Options:"
    echo -e "  ${GREEN}--all${NC}        Reload all configs non-interactively"
    echo -e "  ${GREEN}--shell${NC}      Reload only shell configs (zshrc, bashrc)"
    echo -e "  ${GREEN}--settings${NC}   Reload only PolyTerm settings"
    echo -e "  ${GREEN}--mux-config${NC} Reload only multiplexer configuration"
    echo -e "  ${GREEN}--mux-restart${NC} Restart multiplexer only"
    echo ""
}

# Detect and fix root-owned artifacts from a previous aborted sudo run
check_root_artifacts() {
    local found=false
    local paths=("$HOME/dotfiles" "$HOME/dotfiles/../dotfiles-data" "$HOME/.config" "$HOME/.gemini")
    for p in "${paths[@]}"; do
        [[ -d "$p" ]] || continue
        if find "$p" -user root 2>/dev/null | head -1 | grep -q .; then
            found=true
            break
        fi
    done

    if [[ "$found" == false ]]; then
        return 0
    fi

    echo -e "${RED}⚠️  Some files from a previous sudo run are still owned by root.${NC}"
    echo -e "${YELLOW}This blocks 'git pull' and symlink creation during setup.${NC}"
    echo ""
    echo -e "Run this command to fix:"
    echo -e "  ${GREEN}sudo chown -R $(whoami) ~/dotfiles ~/dotfiles/../dotfiles-data ~/.config ~/.gemini${NC}"
    echo ""
    printf "Fix ownership now? (Y/n): "
    read -r resp
    if [[ ! "$resp" =~ ^[nN] ]]; then
        sudo chown -R "$(whoami)" ~/dotfiles ~/dotfiles/../dotfiles-data ~/.config ~/.gemini 2>/dev/null || true
        echo -e "${GREEN}✅  Ownership fixed.${NC}"
    else
        echo -e "${YELLOW}⚠️  Skipping ownership fix — setup may fail with permission errors.${NC}"
    fi
}

case "$1" in
    setup)
        check_root_artifacts
        echo -e "🚀  ${BLUE}Starting PolyTerm Setup...${NC}"
        bash "$REPO_PATH/application-package/install.sh"
        ;;
    offboard)
        echo -e "🗑️  ${BLUE}Starting PolyTerm Offboarding...${NC}"
        bash "$REPO_PATH/application-package/uninstall.sh"
        ;;
    scan)
        echo -e "🛡️  ${BLUE}Starting Security Scan...${NC}"
        zsh -ic "dot-scan"
        ;;
    sync)
        echo -e "🔄  ${BLUE}Syncing Dotfiles...${NC}"
        # We use zsh -ic to ensure aliases/functions are loaded
        zsh -ic "dot-sync"
        ;;
    pull)
        echo -e "📥  ${BLUE}Pulling Updates...${NC}"
        zsh -ic "dot-pull"
        ;;
    reload)
        case "$2" in
            --all)
                echo -e "  ${BLUE}Reloading All Configs...${NC}"
                zsh -ic "dot-reload-all"
                ;;
            --shell)
                echo -e "  ${BLUE}Reloading Shell Configs...${NC}"
                zsh -ic "dot-reload-shell"
                ;;
            --settings)
                echo -e "  ${BLUE}Reloading PolyTerm Settings...${NC}"
                zsh -ic "dot-reload-settings"
                ;;
            --mux-config)
                echo -e "  ${BLUE}Reloading Multiplexer Config...${NC}"
                zsh -ic "dot-reload-mux-config"
                ;;
            --mux-restart)
                echo -e "  ${BLUE}Restarting Multiplexer...${NC}"
                zsh -ic "dot-restart-mux"
                ;;
            *)
                echo -e "  ${BLUE}Interactive Reload...${NC}"
                zsh -ic "dot-reload-interactive"
                ;;
        esac
        ;;
    palette)
        # Check if inside Tmux or Zellij
        if [[ -n "$TMUX" || -n "$ZELLIJ" ]]; then
            "$REPO_PATH/common/palette/palette.sh"
        else
            echo -e "${YELLOW}Warning: Palette must be run inside a Tmux or Zellij session.${NC}"
            echo -e "Starting a new Tmux session..."
            tmux new-session "$REPO_PATH/common/palette/palette.sh"
        fi
        ;;
    help|--help|-h)
        show_help
        ;;
    "")
        # Default action: Palette
        if [[ -n "$TMUX" || -n "$ZELLIJ" ]]; then
            "$REPO_PATH/common/palette/palette.sh"
        else
            show_help
        fi
        ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        show_help
        exit 1
        ;;
esac
