# shellcheck shell=bash
# =============================================================================
# 🖥️  WSL (UBUNTU) - zshrc
# =============================================================================

# 1. PATH & ENVIRONMENT
# -----------------------------------------------------------------------------
# Determine the root of the dotfiles repository dynamically
export DOTFILES_ROOT="${${${(%):-%x}:A}:h:h:h}"
export DOTFILES_DATA="${DOTFILES_DATA:-${DOTFILES_ROOT}/../dotfiles-data}"
export OS_ENV="wsl"

# Helper function to detect agent or non-interactive environments
is_agent_or_non_interactive() {
    [[ $- != *i* ]] && return 0
    [[ "$TERM" == "dumb" ]] && return 0
    [[ ! -t 1 ]] && return 0
    [[ -n "$CI" || -n "$GITHUB_ACTIONS" || -n "$AGENT_ENV" || -n "$ANTIGRAVITY" ]] && return 0
    return 1
}

if is_agent_or_non_interactive; then
    # Minimalist, clean setup for agents/non-interactive scripts
    export PROMPT='$ '
    export PATH="$HOME/.local/bin:$PATH"
    [[ -f "/home/linuxbrew/.linuxbrew/bin/brew" ]] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    return
fi

# Load all settings and themes
[[ -f "$DOTFILES_ROOT/common/palette/settings-loader.sh" ]] && source "$DOTFILES_ROOT/common/palette/settings-loader.sh"

export PATH="$HOME/.local/bin:$PATH"
[[ -f "/home/linuxbrew/.linuxbrew/bin/brew" ]] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

# Optimization: Speed up Homebrew by disabling automatic cleanup after install
export HOMEBREW_NO_INSTALL_CLEANUP=1

# Boot up x-cmd
[ ! -f "$HOME/.x-cmd.root/X" ] || . "$HOME/.x-cmd.root/X"

# Skip multiplexer autostart when invoked for a CLI command (e.g. polyterm sync)
[[ -n "$POLYTERM_CLI" ]] && unset POLYTERM_CLI && return

# Auto-start multiplexer cockpit on interactive shell login
if [[ -o interactive ]] && [[ -z "$TMUX" ]] && [[ -z "$ZELLIJ" ]]; then
    # Default to zellij, but maintain your POLYTERM_MULTIPLEXER override logic
    local multiplexer="${POLYTERM_MULTIPLEXER:-zellij}"
    
    # Run the multiplexer without 'exec'. 
    # When you detach or exit, you will land safely back in your standard Zsh prompt.
    if command -v "$multiplexer" >/dev/null 2>&1; then
        if [[ "$multiplexer" == "tmux" ]]; then
            tmux set-environment -g DOTFILES_ROOT "$DOTFILES_ROOT"
            tmux set-environment -g POLYTERM_PATH_PALETTE_SCRIPT "$POLYTERM_PATH_PALETTE_SCRIPT"
            tmux set-environment -g POLYTERM_PATH_TMUX_TPM_DIR "$POLYTERM_PATH_TMUX_TPM_DIR"
            tmux set-environment -g POLYTERM_TMUX_COLOR_ACCENT "$POLYTERM_TMUX_COLOR_ACCENT"
            tmux set-environment -g POLYTERM_TMUX_COLOR_BACKGROUND "$POLYTERM_TMUX_COLOR_BACKGROUND"
            tmux set-environment -g POLYTERM_TMUX_COLOR_FOREGROUND "$POLYTERM_TMUX_COLOR_FOREGROUND"
            tmux set-environment -g POLYTERM_TMUX_COLOR_INACTIVE "$POLYTERM_TMUX_COLOR_INACTIVE"
            tmux set-environment -g POLYTERM_TMUX_COLOR_SUBTLE "$POLYTERM_TMUX_COLOR_SUBTLE"
            tmux set-environment -g POLYTERM_APP_MONITOR "$POLYTERM_APP_MONITOR"
            tmux set-environment -g POLYTERM_APP_CONTAINER_CLI "$POLYTERM_APP_CONTAINER_CLI"
            tmux set-environment -g POLYTERM_POPUP_WIDTH "$POLYTERM_POPUP_WIDTH"
            tmux set-environment -g POLYTERM_POPUP_HEIGHT "$POLYTERM_POPUP_HEIGHT"
            tmux set-environment -g POLYTERM_DASHBOARD_PANE_SIZE "$POLYTERM_DASHBOARD_PANE_SIZE"
            tmux attach-session -t Dashboard 2>/dev/null || tmux new-session -s Dashboard
        else
(
                export POLYTERM_COLOR_BACKGROUND="$POLYTERM_COLOR_BACKGROUND"
                export POLYTERM_COLOR_FOREGROUND="$POLYTERM_COLOR_FOREGROUND"
                export POLYTERM_COLOR_BLACK="$POLYTERM_COLOR_BLACK"
                export POLYTERM_COLOR_RED="$POLYTERM_COLOR_RED"
                export POLYTERM_COLOR_GREEN="$POLYTERM_COLOR_GREEN"
                export POLYTERM_COLOR_YELLOW="$POLYTERM_COLOR_YELLOW"
                export POLYTERM_COLOR_BLUE="$POLYTERM_COLOR_BLUE"
                export POLYTERM_COLOR_PURPLE="$POLYTERM_COLOR_PURPLE"
                export POLYTERM_COLOR_CYAN="$POLYTERM_COLOR_CYAN"
                export POLYTERM_COLOR_WHITE="$POLYTERM_COLOR_WHITE"
                export POLYTERM_COLOR_BRIGHT_BLACK="$POLYTERM_COLOR_BRIGHT_BLACK"
                "$multiplexer"
            )
        fi
    fi
fi

# 2. AESTHETICS & PROMPT
# -----------------------------------------------------------------------------
PROMPT='%F{cyan}[%1d] > %f'
export COLORTERM=truecolor
export MICRO_TRUECOLOR=1

# Enable colorized output for ls (Ubuntu/GNU format)
alias ls='ls --color=auto'
alias grep='grep --color=auto'

# Set up GNU dircolors if available
if [ -x /usr/bin/dircolors ]; then
    eval "$(dircolors -b)"
fi

# 3. ANTIDOTE PLUGINS COMPILATION & LOAD
# -----------------------------------------------------------------------------
local zsh_plugins="$HOME/.zsh_plugins.zsh"
local plugins_txt="$DOTFILES_ROOT/common/config/zsh/plugins.txt"
if [[ -f "$plugins_txt" && -d "$HOME/.antidote" ]]; then
    if [[ ! -f "$zsh_plugins" || "$plugins_txt" -nt "$zsh_plugins" ]]; then
        source "$HOME/.antidote/antidote.zsh"
        antidote bundle < "$plugins_txt" >| "$zsh_plugins"
    fi
    source "$zsh_plugins"
fi

zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"


# 4. ALIASES & KEYBOARDS
# -----------------------------------------------------------------------------
alias search='ddgr --reg en-us --num 5'
alias glow="$POLYTERM_APP_MARKDOWN_VIEWER -w $POLYTERM_GLOW_WIDTH"
alias poly-sync="gh repo list INTxK --topic polyos --limit 1000 --json nameWithOwner -q '.[].nameWithOwner' | while read -r repo; do dir=\${repo##*/}; if [ -d \"\$dir\" ]; then echo \"󰇚 Updating \$dir...\"; git -C \"\$dir\" pull; else echo \"󰇚 Cloning \$dir...\"; gh repo clone \"\$repo\"; fi; done"
alias reload-tmux='dot-reload'
alias restart-tmux='tmux kill-server'
alias kbcheck='hidutil property --get "UserKeyMapping"'
alias fixkb='~/kb_toggle.sh'

# 5. AUTOMATED AUTHENTICATION (SSH Agent)
# -----------------------------------------------------------------------------
if [ -z "$SSH_AUTH_SOCK" ]; then
   eval "$(ssh-agent -s)" > /dev/null
   ssh-add ~/.ssh/id_ed25519 2>/dev/null
fi

# 6. DOTFILES AUTOMATION & COMMANDS
# -----------------------------------------------------------------------------
# Source modular commands
[[ -f "$DOTFILES_ROOT/common/palette/helpers.sh" ]] && source "$DOTFILES_ROOT/common/palette/helpers.sh"
[[ -f "$DOTFILES_ROOT/common/palette/security.sh" ]] && source "$DOTFILES_ROOT/common/palette/security.sh"
[[ -f "$DOTFILES_ROOT/common/palette/sync.sh" ]] && source "$DOTFILES_ROOT/common/palette/sync.sh"

# Always update security tools on start in background
(brew upgrade gemini-cli shellcheck lynis &>/dev/null &)

# 7. AI & LLM ALIASES
# -----------------------------------------------------------------------------
if [[ "$(git config user.email 2>/dev/null)" == "developer11.intxk@gmail.com" ]]; then
    alias gemini="timeout 1h gemini --model flash-lite"
    alias gemini-flash="timeout 1h gemini --model flash-3.0"
    alias gemini-pro="timeout 1h gemini --model pro-3.1"
    alias check-spend="gcloud beta billing quotas list --format='table(limit,usage)'"

    ask_gemini() {
        if [[ -f "$1" ]]; then
            local file_size
            if [[ "$OSTYPE" == "darwin"* ]]; then
                file_size=$(stat -f%z "$1")
            else
                file_size=$(stat -c %s "$1")
            fi
            if (( file_size > 50000 )); then
                echo "󰒃  Safety: File is too large ($file_size bytes). Use grep or tail first."
                return 1
            fi
        fi
        gemini "$@"
    }
fi

# Copy from WSL to Windows Clipboard
alias clip="clip.exe"

# Paste from Windows Clipboard into WSL
alias paste="powershell.exe -GetClipboard"

# 8. LOCAL OVERRIDES (Not synced via Git)
# -----------------------------------------------------------------------------
[[ -f "$HOME/.zshrc_local" ]] && source "$HOME/.zshrc_local"

# opencode
export PATH="$HOME/.opencode/bin:$PATH"
