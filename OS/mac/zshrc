# ====================================================
# PolyTerm zshrc - macOS Optimized Edition
# Inspired by the Peppermint Design System
# ====================================================

# --- 1. Environment & Path Setup ---

# Detect Apple Silicon vs Intel Homebrew paths
if [[ -f /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -f /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

# Define Dotfiles Root
export DOTFILES_ROOT="${${${(%):-%x}:A}:h:h:h}"
export DOTFILES_DATA="${DOTFILES_DATA:-${DOTFILES_ROOT}/../dotfiles-data}"

# Ensure standard path priority
export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH}"
[[ -d "${HOME}/.local/bin" ]] && export PATH="${HOME}/.local/bin:${PATH}"

# Preferred applications
export EDITOR="micro"
export VISUAL="micro"

# Helper function to detect agent or non-interactive environments
is_agent_or_non_interactive() {
    [[ $- != *i* ]] && return 0
    [[ "$TERM" == "dumb" ]] && return 0
    [[ ! -t 1 ]] && return 0
    [[ -n "$CI" || -n "$GITHUB_ACTIONS" || -n "$AGENT_ENV" || -n "$ANTIGRAVITY" ]] && return 0
    return 1
}

if is_agent_or_non_interactive; then
    export PROMPT='$ '
    export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
    return
fi

# --- 2. Theme (loaded from active POLYTERM_THEME) ---
[[ -f "$DOTFILES_ROOT/common/palette/settings-loader.sh" ]] && source "$DOTFILES_ROOT/common/palette/settings-loader.sh"

# Preferred applications (after settings-loader so POLYTERM_* vars are available)
export PAGER="$POLYTERM_APP_PAGER"
alias glow="$POLYTERM_APP_MARKDOWN_VIEWER -w $POLYTERM_GLOW_WIDTH"

# Glow (Markdown Reader) matching terminal colors
export GLOW_STYLE="dark"

# Skip multiplexer autostart when invoked for a CLI command (e.g. polyterm sync)
[[ -n "$POLYTERM_CLI" ]] && unset POLYTERM_CLI && return

# --- 3. History Configuration ---
HISTFILE="${HOME}/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000

# Share history across sessions immediately
setopt SHARE_HISTORY
setopt APPEND_HISTORY
setopt INC_APPEND_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS
setopt HIST_IGNORE_SPACE

# --- 4. Completions & Keybindings ---
# Load zsh completions
autoload -Uz compinit && compinit

# Navigation keybindings matching OS/Terminal capabilities
bindkey '^[[1;5C' forward-word       # Ctrl + Right Arrow
bindkey '^[[1;5D' backward-word      # Ctrl + Left Arrow
bindkey '^[[3~' delete-char          # Delete Key

# Use vi-like movements in tab completion menus
zstyle ':completion:*' menu select

# --- 5. Custom Peppermint Prompt ---
# Minimal, high contrast, clean. Teal indicator with path relative to home.
autoload -Uz colors && colors
PROMPT="%F{#14b8a6}⸎ %F{#b4b4b4}%~ %F{#89d287}›%f "

# --- 6. Aliases & Functions ---

# Palette Helpers & Automation (shared functions)
[[ -f "$DOTFILES_ROOT/common/palette/helpers.sh" ]] && source "$DOTFILES_ROOT/common/palette/helpers.sh"
[[ -f "$DOTFILES_ROOT/common/palette/security.sh" ]] && source "$DOTFILES_ROOT/common/palette/security.sh"
[[ -f "$DOTFILES_ROOT/common/palette/sync.sh" ]] && source "$DOTFILES_ROOT/common/palette/sync.sh"

# Shell reload is handled by dot-reload() from sync.sh (sourced above)

# Directory Navigation
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."

# Colorized outputs
alias ls="ls -G" # macOS BSD ls colors
alias ll="ls -lhG"
alias la="ls -lahG"
alias grep="grep --color=auto"

# macOS Specific Helpers
alias pb-copy="pbcopy"
alias pb-paste="pbpaste"

# Quick Shortcuts for Configurations
alias v-zsh="micro ${HOME}/.zshrc"
alias v-tmux="micro ${HOME}/.tmux.conf"
alias v-zellij="micro ${HOME}/.config/zellij/config.kdl"

# --- 7. Auto-start Multiplexer (Cockpit) ---
# Prevents spawning inside already active TMUX or Zellij nested environments
if [[ -o interactive ]] && [[ -z "$TMUX" ]] && [[ -z "$ZELLIJ" ]]; then
    # Default is tmux unless POLYTERM_MULTIPLEXER environment variable overrides it
    local multiplexer="tmux"
    if [[ "$POLYTERM_MULTIPLEXER" == "zellij" ]]; then
        multiplexer="zellij"
    fi
    
    # Check if selected command exists before executing
    if command -v "$multiplexer" >/dev/null 2>&1; then
        # Launch or attach
        if [[ "$multiplexer" == "tmux" ]]; then
            tmux set-environment -g DOTFILES_ROOT "$DOTFILES_ROOT"
            tmux set-environment -g POLYTERM_PATH_PALETTE_SCRIPT "$POLYTERM_PATH_PALETTE_SCRIPT"
            tmux set-environment -g POLYTERM_PATH_TMUX_TPM_DIR "$POLYTERM_PATH_TMUX_TPM_DIR"
            tmux set-environment -g POLYTERM_TMUX_COLOR_ACCENT "$POLYTERM_TMUX_COLOR_ACCENT"
            tmux set-environment -g POLYTERM_TMUX_COLOR_BACKGROUND "$POLYTERM_TMUX_COLOR_BACKGROUND"
            tmux set-environment -g POLYTERM_TMUX_COLOR_FOREGROUND "$POLYTERM_TMUX_COLOR_FOREGROUND"
            tmux set-environment -g POLYTERM_TMUX_COLOR_INACTIVE "$POLYTERM_TMUX_COLOR_INACTIVE"
            tmux set-environment -g POLYTERM_TMUX_COLOR_SUBTLE "$POLYTERM_TMUX_COLOR_SUBTLE"
            tmux set-environment -g POLYTERM_APP_MONITOR "$POLYTERM_APP_MONITOR"
            tmux set-environment -g POLYTERM_APP_CONTAINER_CLI "$POLYTERM_APP_CONTAINER_CLI"
            tmux set-environment -g POLYTERM_POPUP_WIDTH "$POLYTERM_POPUP_WIDTH"
            tmux set-environment -g POLYTERM_POPUP_HEIGHT "$POLYTERM_POPUP_HEIGHT"
            tmux set-environment -g POLYTERM_DASHBOARD_PANE_SIZE "$POLYTERM_DASHBOARD_PANE_SIZE"
            # Automatically try to attach to the last session, or start 'Dashboard'
            tmux attach-session -t Dashboard 2>/dev/null || tmux new-session -A -s Dashboard
        elif [[ "$multiplexer" == "zellij" ]]; then
            (
                export POLYTERM_COLOR_BACKGROUND="$POLYTERM_COLOR_BACKGROUND"
                export POLYTERM_COLOR_FOREGROUND="$POLYTERM_COLOR_FOREGROUND"
                export POLYTERM_COLOR_BLACK="$POLYTERM_COLOR_BLACK"
                export POLYTERM_COLOR_RED="$POLYTERM_COLOR_RED"
                export POLYTERM_COLOR_GREEN="$POLYTERM_COLOR_GREEN"
                export POLYTERM_COLOR_YELLOW="$POLYTERM_COLOR_YELLOW"
                export POLYTERM_COLOR_BLUE="$POLYTERM_COLOR_BLUE"
                export POLYTERM_COLOR_PURPLE="$POLYTERM_COLOR_PURPLE"
                export POLYTERM_COLOR_CYAN="$POLYTERM_COLOR_CYAN"
                export POLYTERM_COLOR_WHITE="$POLYTERM_COLOR_WHITE"
                export POLYTERM_COLOR_BRIGHT_BLACK="$POLYTERM_COLOR_BRIGHT_BLACK"
                zellij
            )
        fi
    fi
fi
